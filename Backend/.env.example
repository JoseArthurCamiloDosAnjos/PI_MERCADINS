# ─────────────────────────────────────────────────────────────────────────────
#  Backend — exemplo de variáveis de ambiente (C4)
#
#  Como funciona: copie este arquivo para ".env" e preencha com os valores
#  reais (que NUNCA são versionados no Git). Em produção (Render), as mesmas
#  variáveis são cadastradas na página do serviço, sem nenhum arquivo .env.
#
#  Regra de ouro: valores de desenvolvimento e de produção são diferentes e
#  nunca se misturam — banco local para programar, banco da Neon para o site
#  no ar.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ────────────────────────────────────────────────────────────────
# Porta HTTP do backend (desenvolvimento usa 3001; no Render é definida pela plataforma)
PORT=3001

# "development" no computador, "production" no servidor — controla mensagens de erro detalhadas
NODE_ENV=development

# ── Banco de dados ──────────────────────────────────────────────────────────
# Qual provedor usar: "local" (PostgreSQL do seu computador) ou "neon" (banco online)
DB_PROVIDER=local

# Conexão com o PostgreSQL local (desenvolvimento)
DATABASE_URL_LOCAL=postgres://usuario:senha@localhost:5432/mercadins

# Conexão com o banco da Neon (produção — o mesmo que o site em produção usa)
DATABASE_URL_NEON=postgresql://usuario:senha@ep-xxx.aws.neon.tech/neondb?sslmode=require

# ── Segurança ───────────────────────────────────────────────────────────────
# Chave usada para assinar os tokens de login — gere uma forte e NUNCA compartilhe
# (gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

# ── E-mail (transações e avisos ao cliente) ─────────────────────────────────
# Chave da API do Resend, que envia os e-mails de pedido e redefinição de senha
RESEND_API_KEY=

# ── Site ────────────────────────────────────────────────────────────────────
# Endereço do frontend — usado nos links de e-mail e no sitemap
FRONTEND_URL=http://localhost:5173

# Origens liberadas pelo CORS (separe por vírgula); em branco usa os padrões do servidor
ALLOWED_ORIGINS=http://localhost:5173

# ── Pagamentos (Asaas) ──────────────────────────────────────────────────────
# Token da API do Asaas — pegue no painel: Integrações > Chaves de API.
# Sem ela, checkout de plano e Pix/cartão de pedido não funcionam.
# A chave já DIZ o ambiente: $aact_prod_ = produção, $aact_hmlg_ = sandbox —
# o servidor escolhe a URL pela própria chave (evita o erro 401
# "a chave não pertence a este ambiente").
Assas_API_KEY=

# Endereços da API (o servidor escolhe qual usar pelo prefixo da chave).
Assas_API_URL_Sandbox=https://api-sandbox.asaas.com/
Assas_API_URL_Producao=https://api.asaas.com/

# Força o ambiente (producao | sandbox) — só se quiser sobrescrever a escolha
# automática feita pela chave. Deixe vazio no uso normal.
ASAAS_AMBIENTE=

# Token enviado no cabeçalho "webhook-security-token" pelo Asaas.
# Recomendado: cadastre o MESMO valor na integração de webhook do painel do
# Asaas. Sem ele o webhook continua funcionando, mas o servidor precisa
# conferir cada status direto na API antes de agir (mais lento).
ASAAS_WEBHOOK_TOKEN=

# ── Notificações por telefone (WhatsApp/SMS) ────────────────────────────────
# Provedor usado para enviar os avisos (cadastro, pedido, etc.).
# Vazio = nada é enviado; o aviso fica registrado com status "sem_provedor"
# e a tela de Notificações oferece o botão "Abrir no WhatsApp".
# Opções: meta | twilio | zapi | evolution | webhook
WHATSAPP_PROVIDER=

# WhatsApp Cloud API (Meta) — WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# WHATSAPP_API_VERSION=v20.0

# Twilio (WhatsApp ou SMS) — WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# TWILIO_CHANNEL=whatsapp   (ou "sms")

# Z-API (WhatsApp) — WHATSAPP_PROVIDER=zapi
ZAPI_URL=
ZAPI_TOKEN=

# Evolution API (WhatsApp) — WHATSAPP_PROVIDER=evolution
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_TOKEN=

# Webhook próprio — WHATSAPP_PROVIDER=webhook
NOTIFICACOES_WEBHOOK_URL=
NOTIFICACOES_WEBHOOK_TOKEN=

# ── Dados de demonstração ───────────────────────────────────────────────────
# ID do mercado em destaque na home (opcional; sem valor, a home usa os destaques do banco)
MERCADO_DESTAQUE=
