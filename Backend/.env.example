# ─────────────────────────────────────────────────────────────────────────────
#  Backend — exemplo de variáveis de ambiente (C4)
#
#  Como funciona: copie este arquivo para ".env" e preencha com os valores
#  reais (que NUNCA são versionados no Git). Em produção (Render), as mesmas
#  variáveis são cadastradas na página do serviço, sem nenhum arquivo .env.
#
#  Regra de ouro: valores de desenvolvimento e de produção são diferentes e
#  nunca se misturam — banco local para programar, banco da Neon para o site
#  no ar.
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ────────────────────────────────────────────────────────────────
# Porta HTTP do backend (desenvolvimento usa 3001; no Render é definida pela plataforma)
PORT=3001

# "development" no computador, "production" no servidor — controla mensagens de erro detalhadas
NODE_ENV=development

# ── Banco de dados ──────────────────────────────────────────────────────────
# Qual provedor usar: "local" (PostgreSQL do seu computador) ou "neon" (banco online)
DB_PROVIDER=local

# Conexão com o PostgreSQL local (desenvolvimento)
DATABASE_URL_LOCAL=postgres://usuario:senha@localhost:5432/mercadins

# Conexão com o banco da Neon (produção — o mesmo que o site em produção usa)
DATABASE_URL_NEON=postgresql://usuario:senha@ep-xxx.aws.neon.tech/neondb?sslmode=require

# ── Segurança ───────────────────────────────────────────────────────────────
# Chave usada para assinar os tokens de login — gere uma forte e NUNCA compartilhe
# (gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=troque-por-uma-chave-aleatoria-longa

# ── E-mail (transações e avisos ao cliente) ─────────────────────────────────
# Chave da API do Resend, que envia os e-mails de pedido e redefinição de senha
RESEND_API_KEY=

# Quando TRUE, os e-mails são apenas logados no console (não enviados de verdade).
# Útil em desenvolvimento para não disparar e-mails reais a cada teste.
LOG_EMAILS=false

# ── Site ────────────────────────────────────────────────────────────────────
# Endereço do frontend — usado nos links de e-mail e no sitemap
FRONTEND_URL=http://localhost:5173

# Origens liberadas pelo CORS (separe por vírgula); em branco usa os padrões do servidor.
# Em desenvolvimento (NODE_ENV!=production), origins da rede local (IPs privados
# 10.x, 192.168.x, 172.16-31.x) também são aceitos automaticamente — não precisa
# cadastrar o IP da máquina aqui para testar de outros dispositivos na mesma rede.
ALLOWED_ORIGINS=http://localhost:5173

# ── Imagens ──────────────────────────────────────────────────────────────────
# Onde as fotos enviadas são salvas (padrão: pasta Backend/imagens).
# Opcional: aponte para outro lugar — caminho relativo ao Backend ou absoluto
# (ex.: um disco externo). Em branco usa o padrão.
IMAGENS_DIR=

# ── Pagamentos (Asaas) ──────────────────────────────────────────────────────
# O sistema funciona APENAS em SANDBOX (testes).
# Pegue a chave em: painel do Asaas Sandbox > Integrações > Chaves.
# A chave DEVE começar com $aact_hmlg_ (chave de sandbox).

# Chave do Sandbox (obrigatória):
Assas_API_KEY_Sandbox=

# Endereço da API do Sandbox:
Assas_API_URL_Sandbox=https://api-sandbox.asaas.com/

# Token enviado no cabeçalho "asaas-access-token" pelo Asaas (o legado
# "webhook-security-token" ainda é aceito como fallback). Cadastre o MESMO
# valor como "Auth Token" da integração de webhook no painel do Asaas Sandbox.
# OBRIGATÓRIO: sem token o webhook responde 401 e não processa eventos (fail-closed).
ASAAS_WEBHOOK_TOKEN=

# ── Notificações por e-mail ──────────────────────────────────────────────────
# As notificações (cadastro, pedido, etc.) usam o MESMO serviço de e-mail do
# sistema — basta a RESEND_API_KEY configurada acima. Sem chave, o aviso fica
# apenas registrado no histórico (status "registrada") e nada é disparado.

# ── Dados de demonstração ───────────────────────────────────────────────────
# ID do mercado em destaque na home (opcional; sem valor, a home usa os destaques do banco)
MERCADO_DESTAQUE=
