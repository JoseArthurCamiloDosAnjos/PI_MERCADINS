# ─────────────────────────────────────────────────────────────────────────────
#  Frontend — exemplo de variáveis de ambiente (C4)
#
#  Como funciona: copie este arquivo para ".env" e preencha. Em produção,
#  as variáveis são cadastradas no painel do Render (serviço estático) —
#  ver docs/ambientes.md. Todas as variáveis do frontend precisam começar
#  com VITE_ para chegarem ao navegador — por isso nunca coloque segredo aqui.
# ─────────────────────────────────────────────────────────────────────────────

# Endereço da API do backend
# Desenvolvimento: servidor local na porta 3001
# Produção: https://pi-mercadins.onrender.com
VITE_API_URL=http://localhost:3001

# Supabase (armazenamento de imagens) — OBRIGATÓRIAS: sem elas o app aborta
# no carregamento (services/supabase.ts lança erro)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
