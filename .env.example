# Interpolação do compose.yaml (copie para .env antes de subir o Docker).
# São valores PÚBLICOS de client-side — não colocar segredo aqui.
# Guia completo: docs/ambientes.md

# Vazio = o build usa caminhos relativos (/api/...) e o nginx do container
# faz o proxy para o backend. Só preencher se o frontend rodar fora do Docker.
VITE_API_URL=

# Obrigatórios: o build falha sem eles (services/supabase.ts lança erro).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
