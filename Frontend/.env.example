# ─────────────────────────────────────────────────────────────────────────────
#  Frontend — exemplo de variáveis de ambiente (C4)
#
#  Como funciona: copie este arquivo para ".env" e preencha. Em produção
#  (Vercel), as variáveis são cadastradas na configuração do projeto.
#  Todas as variáveis do frontend precisam começar com VITE_ para chegarem
#  ao navegador — por isso nunca coloque segredo aqui.
# ─────────────────────────────────────────────────────────────────────────────

# Endereço da API do backend
# Desenvolvimento: servidor local na porta 3001
# Produção: https://pi-mercadins.onrender.com
VITE_API_URL=http://localhost:3001

# Configurações do Supabase (armazenamento de imagens) — só em uso se o
# projeto estiver usando o Supabase para as fotos
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
